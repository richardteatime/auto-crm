# =============================================================================
# Auto-CRM / SarconX Auto-CRM AI Orchestrator — Environment Variables
# =============================================================================
# Copia questo file in `.env.local` e riempi i valori.
# Nessuna variabile e obbligatoria per avviare il dev server, ma il backend
# Appwrite e le funzionalita AI richiedono la configurazione delle sezioni
# "Appwrite" e "AI Provider".
# =============================================================================

# ---------------------------------------------------------------------------
# Appwrite — REQUIRED per il backend (database, auth, storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost:80/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=crm

# ---------------------------------------------------------------------------
# Auth — REQUIRED per la sessione HMAC
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-random-64-char-string

# ---------------------------------------------------------------------------
# AI Provider — opzionale. Serve per classificazione lead e intent classifier
# ---------------------------------------------------------------------------
# OpenRouter (default): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI diretto — richiesto per trascrivere audio/voice Telegram
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=it

# Anthropic fallback (opzionale): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Email Digest — opzionale. Richiede Resend (https://resend.com, gratis)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
DIGEST_EMAIL=
DIGEST_FROM=onboarding@resend.dev

# ---------------------------------------------------------------------------
# AI Orchestrator — Chatwoot / WhatsApp integration
# ---------------------------------------------------------------------------
# Numeri WhatsApp founder/admin abilitati ai comandi interni (separati da virgola)
ADMIN_WHATSAPP_NUMBERS=+393331234567
# Telegram user ID founder/admin abilitati ai comandi interni legacy (separati da virgola).
# Per multi-operatore usare la collection crm_operators; questa variabile resta fallback di emergenza.
ADMIN_TELEGRAM_IDS=

# Telegram bot diretto online
# TELEGRAM_WEBHOOK_SECRET deve combaciare con secret_token usato in setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DROP_PENDING_UPDATES=false
TELEGRAM_AUDIO_MAX_SECONDS=120
TELEGRAM_AUDIO_MAX_BYTES=20971520
# JSON per seed multi-operatore. Esempio:
# [{"name":"Leonardo","telegramUserId":"123456789","role":"admin","scopes":["*"]}]
CRM_OPERATORS_JSON=
CRM_CONFIRMATION_MODE=risky
CRM_CONFIRMATION_TTL_MINUTES=10

# Chatwoot instance settings
CHATWOOT_URL=https://your-chatwoot-instance.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# URL pubblico del CRM (usato per callback GitAgent/deploy)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Feature Flags — Orchestrator
# ---------------------------------------------------------------------------
# Abilita comandi interni (Step 1: founder/admin)
ENABLE_INTERNAL_COMMANDS=true

# Abilita dispacciamento a GitAgent (default: false fino a validazione Gate)
ENABLE_GITAGENT_DISPATCH=false

# Abilita auto-deploy preview (default: false)
ENABLE_AUTODEPLOY_PREVIEW=false

# Modalita customer (Step 2) — BLOCCATO fino a validazione Gate
ENABLE_CUSTOMER_AUTOMATION=false
CUSTOMER_AUTOMATION_UNLOCKED=false

# ---------------------------------------------------------------------------
# GitAgent — opzionale. Serve solo se ENABLE_GITAGENT_DISPATCH=true
# ---------------------------------------------------------------------------
GITAGENT_ENDPOINT=https://your-gitagent.example.com/api/dispatch
GITAGENT_API_KEY=
GITAGENT_CALLBACK_SECRET=change-me-gitagent-secret

# ---------------------------------------------------------------------------
# Deploy — opzionale. Serve per validare callback deploy
# ---------------------------------------------------------------------------
DEPLOY_CALLBACK_SECRET=change-me-deploy-secret

# ---------------------------------------------------------------------------
# Lead Pipeline (MVP) — opzionale. Sistema lead → pipeline → automazioni → Leo
# ---------------------------------------------------------------------------
# Secret per l'endpoint inbound /api/leads/email-inbound (opzionale; se vuoto,
# l'endpoint accetta senza verifica ma resta rate-limited per IP).
LEAD_INBOUND_WEBHOOK_SECRET=

# Email automazioni lead (riutilizzano Resend, RESEND_API_KEY sopra).
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
LEO_EMAIL=
FOUNDER_EMAIL=

# Identita dell'agente che riceve le call task (default: id "leo", nome "Leo").
LEO_USER_ID=leo
LEO_NAME=Leo

# n8n — esecutore automazioni esterno (PLACEHOLDER, disabilitato di default).
# Quando ENTRAMBI sono valorizzati (flag=true + webhook url), i trigger lead
# vengono inoltrati a n8n invece dell'engine interno. Se l'inoltro fallisce,
# il sistema fa fallback automatico all'engine interno (non blocca mai il flusso).
ENABLE_N8N_AUTOMATIONS=false
N8N_WEBHOOK_URL=
N8N_API_KEY=

# ---------------------------------------------------------------------------
# Workflow Engine — Secrets obbligatori per endpoint interni
# ---------------------------------------------------------------------------
# Secret per triggerare workflow via /api/workflow/trigger
WORKFLOW_TRIGGER_SECRET=change-me-workflow-trigger-secret
# Secret per il worker scheduled /api/workflow/process-scheduled
WORKFLOW_WORKER_SECRET=change-me-workflow-worker-secret

# ---------------------------------------------------------------------------
# Finance — Whitelist utenti che possono accedere alla sezione Finance
# ---------------------------------------------------------------------------
# Lista di user ID separati da virgola. Se vuoto, tutti gli utenti autenticati
# hanno accesso (comportamento legacy).
FINANCE_USER_IDS=

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Redis — opzionale. Se valorizzato, il rate limiter usa Redis invece della
# memoria locale (necessario per multi-instance o restart-safe).
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# CORS — Origini consentite per le API pubbliche (/api/public/*)
# ---------------------------------------------------------------------------
# Separati da virgola. Se vuoto, fallback a "*" in dev, warning in produzione.
PUBLIC_API_ORIGINS=

# ---------------------------------------------------------------------------
# Hermes Agent Service — opzionale. Se HERMES_SERVICE_URL è valorizzato,
# il CRM chiama il servizio Hermes via HTTP invece di spawnare il binario locale.
# ---------------------------------------------------------------------------
HERMES_SERVICE_URL=
HERMES_API_KEY=
